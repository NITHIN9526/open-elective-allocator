<%- include("partials/header", { title }) %>
</main>
<div class="oe-auth-page oe-form-page">
  <main class="oe-auth-shell">
    <section class="oe-brand-side">
      <div class="oe-brand-mark"><span>OE</span></div>
      <div class="oe-brand-copy oe-form-brand-copy">
        <p class="oe-eyebrow">OPEN ELECTIVE PORTAL</p>
        <h1>Your academic journey<br><span>starts here.</span></h1>
        <div class="oe-brand-rule"></div>
        <p class="oe-brand-description">Create your student account to take part in the elective course allocation process at Government Polytechnic College, Palakkad.</p>
        <div class="oe-form-side-list">
          <div class="oe-form-side-item"><span>01</span> Register using your assigned PRN</div>
          <div class="oe-form-side-item"><span>02</span> Wait for administrator approval</div>
          <div class="oe-form-side-item"><span>03</span> Sign in to submit your preferences</div>
        </div>
      </div>
      <div class="oe-brand-bottom"><span class="oe-status-dot"></span> Student registration · Secure access</div>
      <i class="oe-decor oe-decor-one"></i><i class="oe-decor oe-decor-two"></i>
    </section>
    <section class="oe-login-side">
      <div class="oe-login-content">
        <p class="oe-login-kicker oe-form-login-kicker">STUDENT ACCOUNT</p>
        <h2>Create your account</h2>
        <p class="oe-login-subtitle">Enter your PRN and choose a secure password. Your roster details will be loaded automatically.</p>
        <% if (error) { %><div class="oe-form-alert" role="alert"><%= error %></div><% } %>
        <form method="post" action="/register" class="oe-form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="oe-form-group">
            <label for="register-prn">PRN (Permanent Registration Number)</label>
            <input id="register-prn" class="oe-form-control" name="prn" autocomplete="username" required placeholder="Enter your assigned PRN">
          </div>
          <div class="oe-form-group">
            <label for="register-password">Create password</label>
            <input id="register-password" class="oe-form-control" type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password" required placeholder="At least 10 characters">
          </div>
          <div class="oe-form-group">
            <label for="register-confirm-password">Confirm password</label>
            <input id="register-confirm-password" class="oe-form-control" type="password" name="confirmPassword" minlength="10" maxlength="72" autocomplete="new-password" required placeholder="Re-enter your password">
          </div>
          <button class="oe-form-submit" type="submit">Submit registration <span aria-hidden="true">→</span></button>
        </form>
        <div class="oe-form-note">Your account will remain pending until an administrator reviews and approves it.</div>
        <div class="oe-form-links"><a href="/login">← Back to home</a><a href="/student/login">Already registered? Sign in</a></div>
      </div>
      <div class="oe-login-footer">© <%= new Date().getFullYear() %> Open Elective Portal · Government Polytechnic College, Palakkad</div>
    </section>
  </main>
</div>
<script src="/app.js"></script>
</body>
</html>
