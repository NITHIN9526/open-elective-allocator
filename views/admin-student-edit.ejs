<%- include("partials/header", { title }) %>
<div class="page-heading"><span class="eyebrow">ADMINISTRATION</span><h1>Edit Student Record</h1><p class="text-muted">Only administrators can change submitted student details. Changes are saved in the portal database.</p></div>
<div class="card" style="max-width:760px;margin:20px auto"><div class="card-body">
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="alert info">PRN is the unique student identifier and cannot be changed here.</div>
<form method="post" action="/admin/students/<%= encodeURIComponent(student.prn) %>/edit" class="form-stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group"><label class="form-label">PRN</label><input class="form-control" value="<%= student.prn %>" readonly></div>
<div class="form-group"><label class="form-label" for="name">Student name</label><input class="form-control" id="name" name="name" maxlength="120" value="<%= student.name || '' %>" required></div>
<div class="form-group"><label class="form-label" for="department">Department</label><select class="form-control" id="department" name="department" required><% departments.forEach(d => { %><option value="<%= d.code %>" <%= student.department === d.code ? "selected" : "" %>><%= d.name %> (<%= d.code %>)</option><% }) %></select></div>
<div class="form-group"><label class="form-label" for="mobile">Mobile number</label><input class="form-control" id="mobile" name="mobile" value="<%= student.mobile || '' %>" required></div>
<div class="form-group"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" value="<%= student.email || '' %>" required></div>
<div class="form-group"><label class="form-label" for="cgpa">CGPA</label><input class="form-control" id="cgpa" name="cgpa" type="number" min="0" max="10" step="0.01" value="<%= student.cgpa ?? '' %>" required></div>
<div class="form-group"><label class="form-label" for="semester">Current semester</label><select class="form-control" id="semester" name="semester" required><% for(let i=1;i<=6;i++){ %><option value="<%= i %>" <%= Number(student.semester)===i ? "selected" : "" %>>Semester <%= i %></option><% } %></select></div>
<div class="form-group"><label class="form-label" for="academicYear">Academic year</label><input class="form-control" id="academicYear" name="academicYear" pattern="[0-9]{4}-[0-9]{2}" value="<%= student.academicYear || config.academicYear %>" required></div>
<div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn btn-primary">Save student details</button><a class="btn btn-secondary" href="/admin/students">Cancel</a></div>
</form></div></div>
<%- include("partials/footer") %>