<%- include("partials/header", { title }) %>
</main>
<section class="login-choice">
  <div class="login-choice-heading">
    <span class="eyebrow">GOVERNMENT POLYTECHNIC COLLEGE, PALAKKAD</span>
    <h1>Open Elective Portal</h1>
    <p>Select the portal you want to access.</p>
  </div>
  <div class="login-choice-grid">
    <a class="login-choice-card student-choice" href="/student/login">
      <span class="login-choice-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#book"></use></svg></span><span class="login-choice-title">Student Login</span>
      <span class="login-choice-description">Sign in with your PRN to submit elective preferences and view allotment results.</span>
      <span class="login-choice-action">Continue as Student <svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></span>
    </a>
    <a class="login-choice-card admin-choice" href="/admin/login">
      <span class="login-choice-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#lock"></use></svg></span><span class="login-choice-title">Admin Login</span>
      <span class="login-choice-description">Authorized administrators can manage students, courses, preferences and allotments.</span>
      <span class="login-choice-action">Continue as Admin →</span>
    </a>
  </div>
  <p class="login-choice-register">New student? <a href="/register">Create your account</a></p>
</section>
<footer class="footer">© <%= new Date().getFullYear() %> Open Elective Portal · Government Polytechnic College, Palakkad</footer>
<script src="/app.js"></script>
</body>
</html>