<%- include("partials/header", { title }) %>
</main>
<section class="oe-auth-page">
  <div class="oe-auth-shell">
    <div class="oe-brand-side">
      <div class="oe-brand-mark" aria-hidden="true"><span>OE</span></div>
      <div class="oe-brand-copy">
        <p class="oe-eyebrow">GOVERNMENT POLYTECHNIC COLLEGE · PALAKKAD</p>
        <h1>Open Elective<br><span>Portal</span></h1>
        <div class="oe-brand-rule"></div>
        <p class="oe-brand-description">A simple and transparent way to explore elective courses, submit your preferences and view your course allocation.</p>
      </div>
      <div class="oe-brand-bottom">
        <span class="oe-status-dot"></span>
        <span>Student elective allocation system</span>
      </div>
      <div class="oe-decor oe-decor-one"></div><div class="oe-decor oe-decor-two"></div>
    </div>

    <div class="oe-login-side">
      <div class="oe-login-content">
        <div class="oe-mobile-mark">OE</div>
        <p class="oe-login-kicker">WELCOME</p>
        <h2>Sign in to continue</h2>
        <p class="oe-login-subtitle">Choose your account type to access the portal.</p>

        <a class="oe-login-option oe-student-option" href="/student/login">
          <span class="oe-option-icon">S</span>
          <span class="oe-option-copy"><strong>Student Login</strong><small>Access your elective preferences and allotment</small></span>
          <span class="oe-option-arrow"><svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></span>
        </a>

        <a class="oe-login-option oe-admin-option" href="/admin/login">
          <span class="oe-option-icon">A</span>
          <span class="oe-option-copy"><strong>Admin Login</strong><small>Manage courses, students and allocations</small></span>
          <span class="oe-option-arrow">→</span>
        </a>

        <div class="oe-register-line">
          <span>New student?</span>
          <a href="/register">Create an account <span><svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></span></a>
        </div>
      </div>
      <footer class="oe-login-footer">© <%= new Date().getFullYear() %> Open Elective Portal</footer>
    </div>
  </div>
</section>
<script src="/app.js"></script>
</body></html>
