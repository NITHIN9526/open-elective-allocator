<%- include("partials/header", { title }) %>
</main>
<section class="oe-landing">
  <div class="oe-intro">
    <div class="oe-logo" aria-hidden="true"><span>OE</span><i>✦</i></div>
    <h1>Open Elective Portal</h1>
    <h2>Government Polytechnic College, Palakkad</h2>
    <p class="oe-tagline">A Simple and Transparent Course Allocation System</p>
    <p class="oe-description">Explore elective courses, submit your preferences and track your allotment in one place.</p>
  </div>
  <section class="oe-student-panel" aria-labelledby="student-login-heading">
    <div class="oe-panel-heading">
      <div class="oe-role-icon student-icon">♧</div>
      <div><h2 id="student-login-heading">Student Login <span class="oe-most-used">MOST USED</span></h2>
      <p>Access your elective courses and allocation dashboard</p></div>
    </div>
    <a class="oe-student-button" href="/student/login">Sign In as Student <span>→</span></a>
    <div class="oe-student-features">
      <div><span>⌕</span><small>Browse Courses</small></div>
      <div><span>▤</span><small>Rank Preferences</small></div>
      <div><span>♙</span><small>Track Allotment</small></div>
    </div>
    <div class="oe-stats">
      <div><strong><%= stats.departments %>+</strong><small>Departments</small></div>
      <div><strong><%= stats.courses %>+</strong><small>Elective Courses</small></div>
      <div><strong><%= stats.students %>+</strong><small>Students</small></div>
    </div>
  </section>
  <div class="oe-register">
    <p>New student? Create your account</p>
    <a href="/register"><span>♙</span> Register Now <b>›</b></a>
  </div>
  <section class="oe-admin-grid" aria-label="Administrative portals">
    <a class="oe-admin-card officer-card" href="/admin/login">
      <span class="oe-admin-icon">▥</span>
      <h2>Placement Officer</h2>
      <p>Manage students, courses, preferences and the elective allocation process</p>
      <strong>Continue <span>→</span></strong>
    </a>
    <a class="oe-admin-card super-card" href="/admin/login">
      <span class="oe-admin-icon">♢</span>
      <h2>Super Admin</h2>
      <p>Oversee the portal, manage administration and monitor allocation activity</p>
      <strong>Continue <span>→</span></strong>
    </a>
  </section>
  <footer class="oe-footer">© <%= new Date().getFullYear() %> Open Elective Portal · Government Polytechnic College, Palakkad</footer>
</section>
<script src="/app.js"></script>
</body></html>
