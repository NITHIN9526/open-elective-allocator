<%- include("partials/header", { title }) %>

<div class="heading-row">
  <div class="page-heading">
    <span class="eyebrow">ADMINISTRATION</span>
    <h1>Audit Log</h1>
    <p class="text-muted">Recent account and allocation actions.</p>
  </div>
  <div class="search-box">
    <span class="search-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search"></use></svg></span>
    <input type="text" placeholder="Search logs..." data-search-target="audit-table">
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <div class="table-wrap">
      <table id="audit-table">
        <thead>
          <tr><th>Time</th><th>Actor</th><th>Action</th><th>Details</th></tr>
        </thead>
        <tbody>
          <% entries.forEach(e => { %>
          <tr>
            <td><span class="text-xs"><%= new Date(e.at).toLocaleString() %></span></td>
            <td><strong><%= e.actor %></strong></td>
            <td><span class="badge badge-gray"><%= e.action %></span></td>
            <td class="text-muted"><%= e.details %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
