<%- include("partials/header", { title }) %>

<div class="page-heading">
  <span class="eyebrow">STUDENT PORTAL</span>
  <h1>My Allotment</h1>
  <p class="text-muted">Your allocation result and approval status.</p>
</div>

<% if (!result) { %>
  <div class="card"><div class="empty" style="padding:60px 24px;">
    <div style="font-size:48px;margin-bottom:16px;">📭</div>
    <strong>Allocation not generated yet</strong>
    <p class="text-muted mt-sm text-sm">The administrator has not yet run the allocation process. Check back later.</p>
  </div></div>
<% } else { %>
  <div class="card">
    <div class="card-body result-panel">
      <span class="eyebrow">ALLOCATION STATUS</span>
      <h2><span class="badge <%= result.status === 'APPROVED' ? 'badge-success' : result.status === 'PROPOSED' ? 'badge-warning' : result.status === 'REJECTED' ? 'badge-danger' : 'badge-gray' %>" style="font-size:14px;padding:6px 16px;"><%= result.status %></span></h2>
      <% if (course) { %>
        <div class="result-course-name"><%= course.name %></div>
        <p class="text-muted"><%= course.id %> · Offered by <%= course.offeredBy %></p>
        <p class="text-muted mt-sm">Preference rank: <strong class="rank-badge">#<%= result.preferenceRank %></strong></p>
      <% } else { %>
        <p class="text-muted mt-md">No course was assigned from your submitted preferences.</p>
      <% } %>
      <% if (result.tieFlag) { %>
        <div class="alert info mt-lg" style="display:inline-flex;">Your CGPA is tied with another student. Administrator review is required.</div>
      <% } %>
    </div>
  </div>
<% } %>

<%- include("partials/footer") %>
