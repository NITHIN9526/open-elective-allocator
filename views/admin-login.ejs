<%- include("partials/header", { title }) %>
</main>
<div class="oe-auth-page oe-form-page oe-auth-single">
  <main class="oe-auth-shell">
    <section class="oe-login-side">
      <div class="oe-login-content">
        <div class="oe-single-brand"><span>OE</span><strong>OPEN ELECTIVE PORTAL</strong></div>
        <p class="oe-login-kicker oe-form-login-kicker">ADMINISTRATION</p>
        <h2>Welcome back</h2>
        <p class="oe-login-subtitle">Sign in with your administrator credentials to continue.</p>
        <% if (error) { %><div class="oe-form-alert" role="alert"><%= error %></div><% } %>
        <form method="post" action="/admin/login" class="oe-form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="oe-form-group"><label for="admin-username">Admin username</label><input id="admin-username" class="oe-form-control" name="username" autocomplete="username" required placeholder="Enter admin username"></div>
          <div class="oe-form-group"><label for="admin-password">Password</label><input id="admin-password" class="oe-form-control" type="password" name="password" autocomplete="current-password" required placeholder="Enter your password"></div>
          <button class="oe-form-submit" type="submit">Sign in securely <span aria-hidden="true">→</span></button>
        </form>
        <div class="oe-form-note">This area is restricted to authorized administrators.</div>
        <div class="oe-form-links"><a href="/login">← Back to home</a><span>Need access? Contact the portal administrator.</span></div>
      </div>
      <div class="oe-login-footer">© <%= new Date().getFullYear() %> Open Elective Portal · Government Polytechnic College, Palakkad</div>
    </section>
  </main>
</div>
<script src="/app.js"></script>
</body>
</html>
