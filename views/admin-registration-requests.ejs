<%- include("partials/header", { title }) %>

<div class="heading-row">
  <div class="page-heading">
    <span class="eyebrow">ADMINISTRATION</span>
    <h1>Student Registration Approvals</h1>
    <p class="text-muted">Approve or reject first-time student registrations before students can access the portal.</p>
  </div>
  <div class="badge badge-warning"><%= pendingRegistrations.length %> pending</div>
</div>

<% if (pendingRegistrations.length) { %>
  <div class="card">
    <div class="card-body">
      <div class="approval-actions">
        <form id="bulk-approve-selected" method="post" action="/admin/students/approve-selected">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary" type="submit" onclick="return confirm('Approve all selected student registrations?');">Approve selected</button>
        </form>
        <form method="post" action="/admin/students/approve-all" onsubmit="return confirm('Approve ALL <%= pendingRegistrations.length %> pending student registrations?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-success" type="submit">Approve all (<%= pendingRegistrations.length %>)</button>
        </form>
        <span class="text-muted text-xs">Select individual students below, or approve every pending registration.</span>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2>Pending registrations</h2>
    <span class="text-muted text-xs"><%= pendingRegistrations.length %> awaiting review</span>
  </div>
  <div class="card-body flush">
    <% if (!pendingRegistrations.length) { %>
      <div class="empty">No pending student registrations.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th><input type="checkbox" id="select-all-pending" aria-label="Select all pending students"></th>
              <th>PRN</th><th>Student name</th><th>Department</th><th>Registration date</th><th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% pendingRegistrations.forEach(student => { %>
              <tr>
                <td><input type="checkbox" class="pending-student-checkbox" name="prns" value="<%= student.prn %>" form="bulk-approve-selected" aria-label="Select <%= student.prn %>"></td>
                <td><code><%= student.prn %></code></td>
                <td><strong><%= student.name %></strong></td>
                <td><%= student.department %></td>
                <td><%= student.createdAt ? new Date(student.createdAt).toLocaleString() : "—" %></td>
                <td>
                  <div class="approval-actions">
                    <form method="post" action="/admin/students/<%= encodeURIComponent(student.prn) %>/approve">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-success btn-sm">Approve</button>
                    </form>
                    <form method="post" action="/admin/students/<%= encodeURIComponent(student.prn) %>/reject" onsubmit="return confirm('Reject this student registration?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-sm">Reject</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (reviewedRegistrations.length) { %>
  <div class="card">
    <div class="card-header"><h2>Recently processed registrations</h2></div>
    <div class="card-body flush">
      <div class="table-wrap">
        <table>
          <thead><tr><th>PRN</th><th>Student name</th><th>Department</th><th>Status</th></tr></thead>
          <tbody>
            <% reviewedRegistrations.forEach(student => { %>
              <tr>
                <td><code><%= student.prn %></code></td>
                <td><%= student.name %></td>
                <td><%= student.department %></td>
                <td><span class="badge <%= student.accountStatus === 'ACTIVE' ? 'badge-success' : 'badge-danger' %>"><%= student.accountStatus %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<script>
  (() => {
    const selectAll = document.getElementById("select-all-pending");
    const boxes = Array.from(document.querySelectorAll(".pending-student-checkbox"));
    if (!selectAll) return;
    selectAll.addEventListener("change", () => {
      boxes.forEach(box => { box.checked = selectAll.checked; });
    });
    boxes.forEach(box => box.addEventListener("change", () => {
      selectAll.checked = boxes.length > 0 && boxes.every(item => item.checked);
      selectAll.indeterminate = boxes.some(item => item.checked) && !selectAll.checked;
    }));
    const bulkForm = document.getElementById("bulk-approve-selected");
    if (bulkForm) bulkForm.addEventListener("submit", event => {
      if (!boxes.some(box => box.checked)) {
        event.preventDefault();
        alert("Select at least one student to approve.");
      }
    });
  })();
</script>

<%- include("partials/footer") %>
