<%- include("partials/header", { title }) %>

<div class="heading-row">
  <div class="page-heading">
    <span class="eyebrow">ADMINISTRATION</span>
    <h1>Allotment Review</h1>
    <p class="text-muted">Status: <span class="badge badge-info"><%= status %></span></p>
    <p class="text-muted mt-sm"><strong>Allocation priority:</strong> CGPA above 8.00 first, then CGPA 8.00 or below. Higher CGPA gets priority; equal CGPA is resolved by PRN order. Each student is checked against their preferences from 1st onward.</p>
  </div>
  <a href="/admin" class="btn btn-secondary">← Back to dashboard</a>
</div>

<% if (!rows.length) { %>
  <div class="card"><div class="empty" style="padding:48px;">
    <div style="font-size:40px;margin-bottom:12px;">📭</div>
    No allocation has been generated yet.
  </div></div>
<% } else { %>
  <div class="card">
    <div class="card-body flush">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Student</th><th>CGPA</th><th>Preference</th><th>Proposed Course</th><th>Flags</th><th>Status / Action</th></tr>
          </thead>
          <tbody>
            <% rows.forEach(r => { %>
            <tr>
              <td>
                <strong><%= r.student ? r.student.name : r.prn %></strong>
                <small><%= r.prn %></small>
              </td>
              <td><%= Number(r.cgpa).toFixed(2) %></td>
              <td><%= r.preferenceRank ? '#' + r.preferenceRank : '—' %></td>
              <td><%= r.course ? r.course.name : 'Not allocated' %></td>
              <td>
                <% if (r.tieFlag) { %>
                  <span class="badge badge-warning">CGPA tie</span>
                <% } else { %>—<% } %>
              </td>
              <td>
                <span class="badge <%= r.status === 'APPROVED' ? 'badge-success' : r.status === 'PROPOSED' ? 'badge-warning' : r.status === 'REJECTED' ? 'badge-danger' : 'badge-gray' %>"><%= r.status %></span>
                <% if (r.status === 'PROPOSED') { %>
                <div class="approval-actions mt-sm">
                  <form method="post" action="/admin/allotments/<%= encodeURIComponent(r.prn) %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-success btn-sm">Approve</button></form>
                  <form method="post" action="/admin/allotments/<%= encodeURIComponent(r.prn) %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Reject</button></form>
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="card mt-md">
    <div class="card-body text-sm text-muted">
      <strong>Allocation rule:</strong> Students with CGPA above 8.00 are considered before students with CGPA 8.00 or below. Within each group, higher CGPA is considered first; students with equal CGPA are ordered by PRN. The allocator assigns the first available course in each student's preference order.
    </div>
  </div>
<% } %>

<%- include("partials/footer") %>
