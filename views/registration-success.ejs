<%- include("partials/header", { title }) %>
<div class="narrow">
  <div class="card">
    <div class="card-body success-panel">
      <div class="success-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#check-circle"></use></svg></div>
      <h2>Registration submitted</h2>
      <p class="text-muted">Your account for <strong><%= prn %></strong> is now awaiting administrator approval. You'll be able to sign in once approved.</p>
      <div class="mt-lg">
        <a class="btn btn-primary btn-lg" href="/login">Go to sign in</a>
      </div>
    </div>
  </div>
</div>
<%- include("partials/footer") %>
