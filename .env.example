# Copy this file to .env. Never commit the real .env file.
NODE_ENV=development
PORT=3000
APP_PORT=3000

# Required for production/Docker. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: create the first administrator when the JSON data file is first created.
# Set a unique password between 12 and 72 characters.
# After confirming the first administrator can log in, remove the password from .env.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Portal Administrator
