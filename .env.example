# Copy to .env. Never commit the real .env file.
NODE_ENV=development
PORT=3000
APP_PORT=3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: provision the first administrator when a new local data file is created.
# Use a unique password of 12–72 characters. Remove these values after first setup.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Portal Administrator

# PostgreSQL configuration for the database migration foundation.
POSTGRES_DB=open_elective
POSTGRES_USER=open_elective
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql://open_elective:replace-with-a-strong-local-password@localhost:5432/open_elective
DB_POOL_MAX=10
DATABASE_SSL=false
